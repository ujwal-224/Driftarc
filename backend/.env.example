# DriftCheck Backend Configuration
PORT=3001

# LLM Configuration: Options: 'gemini' or 'openai'
# Option A: Google Gemini API (serves multimodal vision)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI-compatible host (e.g. OpenRouter with Gemma 4, Ollama, etc.)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-4-31b-it
# OPENAI_API_KEY=your_openai_or_openrouter_key_here

# GitHub Integration (optional, tokens are passed per-request from the UI and never logged)
# GITHUB_TOKEN=
